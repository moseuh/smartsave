# Database Configuration
DB_HOST=localhost
DB_USER=your_database_user
DB_PASS=your_database_password
DB_NAME=your_database_name
DEBUG=false

# Informa API Configuration
INFORMA_API_KEY=your_informa_api_key
INFORMA_USE_SANDBOX=true

# M-PESA API Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=your_shortcode
MPESA_B2B_SHORTCODE=your_b2b_shortcode
MPESA_B2B_SECURITY_CREDENTIAL=your_security_credential
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa-callback.php
MPESA_ENV=sandbox

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
